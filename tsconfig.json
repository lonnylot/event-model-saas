{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "public/append-slice.js",
    "public/append-actor.js",
    "public/append-command.js",
    "public/append-event.js",
    "public/append-read-model.js",
    "public/append-automation.js",
    "public/append-connection.js",
    "public/set-slice-title.js",
    "public/set-slice-description.js",
    "public/set-actor-name.js",
    "public/set-command-title.js",
    "public/set-event-title.js",
    "public/set-read-model-title.js",
    "public/set-automation-title.js"
  ]
}
