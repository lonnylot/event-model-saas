{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-model-saas",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SITE_ADMIN_EMAIL": "lonny@lonnylot.com",
    "AUTH_FROM": "auth@event-model.lonnylot.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "event-model-saas",
      "database_id": "1ff26c5c-2c66-41e6-893b-92d610d021f1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "event-model-saas-models"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "routes": [
    { "pattern": "event-model.lonnylot.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*",
      "/app",
      "/app/*",
      "/favicon.png",
      "/og.png",
      "/shell.css"
    ]
  }
}
